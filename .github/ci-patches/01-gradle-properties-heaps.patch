diff --git a/gradle.properties b/gradle.properties
index a9a5262..cc10c3f 100644
--- a/gradle.properties
+++ b/gradle.properties
@@ -2,7 +2,11 @@ android.nonFinalResIds=true
 android.nonTransitiveRClass=true
 android.useAndroidX=true
 kotlin.code.style=official
-org.gradle.jvmargs=-Xmx6144m
+# Keep the Gradle and Kotlin daemon heaps within the ~7 GB RAM available on
+# GitHub's ubuntu-latest runners (the Kotlin daemon inherits org.gradle.jvmargs
+# by default, so a single large -Xmx value would exceed available memory).
+org.gradle.jvmargs=-Xmx4g -XX:MaxMetaspaceSize=1g
+kotlin.daemon.jvmargs=-Xmx2g
 org.gradle.parallel=true
 org.gradle.caching=true
 org.gradle.configuration-cache=true
